# FlowShopy environment example
# Local-first desktop mode should work without a user-managed `.env`.
# The desktop runtime now persists ports in `DATA_DIR/desktop.runtime.json`
# and generates internal runtime secrets locally on first boot.
#
# Keep this file for dev overrides, tooling, tests, and advanced/manual setups.

# DATA_DIR
# Optional override for runtime data location.
# Desktop default: user data folder managed by Electron.
# Repo/dev default: <repo-root>/data
DATA_DIR=

# AUTH_JWT_SECRET
# Optional override for the local session signing secret.
# Desktop default: generated on first boot and stored in runtime secrets file.
AUTH_JWT_SECRET=

# INTERNAL_JOBS_EVENT_TOKEN
# Optional override for trusted API <-> worker local calls.
# Desktop default: generated on first boot and stored in runtime secrets file.
INTERNAL_JOBS_EVENT_TOKEN=

# AGENT_CONTROL_TOKEN_SECRET
# Optional override for local agent-control token signing.
# Desktop default: generated on first boot and stored in runtime secrets file.
AGENT_CONTROL_TOKEN_SECRET=

# AGENT_CONTROL_REQUEST_TIMEOUT_MS
# Timeout (ms) for API waiting worker WS command responses.
AGENT_CONTROL_REQUEST_TIMEOUT_MS=20000

# AGENT_PAIRING_TOKEN_TTL_MS
# Pairing token TTL (ms) for machine onboarding.
AGENT_PAIRING_TOKEN_TTL_MS=600000

# AGENT_CONTROL_TOKEN
# Worker credential returned by /agent-control/validate-worker.
AGENT_CONTROL_TOKEN=

# WORKSPACE_ID
# Worker workspace identity returned by /agent-control/validate-worker.
WORKSPACE_ID=

# AGENT_ID
# Worker agent identity returned by /agent-control/validate-worker.
AGENT_ID=

# AGENT_LABEL
# Optional friendly machine name shown in UI/logs.
AGENT_LABEL=

# MACHINE_FINGERPRINT
# Stable machine identifier sent during pairing/hello.
MACHINE_FINGERPRINT=

# WORKER_INVENTORY_SCAN_INTERVAL_MS
# Worker inventory collector periodic scan interval (ms).
WORKER_INVENTORY_SCAN_INTERVAL_MS=30000

# WORKER_REQUIRE_WS_ON_STARTUP
# true => worker fails startup if WS ready never arrives within timeout.
WORKER_REQUIRE_WS_ON_STARTUP=false

# WORKER_WS_STARTUP_TIMEOUT_MS
# Timeout (ms) to wait for WS ready when WORKER_REQUIRE_WS_ON_STARTUP=true.
WORKER_WS_STARTUP_TIMEOUT_MS=45000

# JOB_MAX_ATTEMPTS
# Max retries per job before hard fail.
JOB_MAX_ATTEMPTS=3

# JOB_LEASE_MS
# Lease duration (ms) for running job ownership.
JOB_LEASE_MS=30000

# JOB_LEASE_HEARTBEAT_MS
# Lease heartbeat interval (ms) while job is running.
JOB_LEASE_HEARTBEAT_MS=10000

# JOB_STALE_AFTER_MS
# Stale job threshold (ms) for recovery logic in API/Worker.
JOB_STALE_AFTER_MS=600000

# APP_SETTINGS_PATH
# Optional custom path for persisted runtime settings.
# Default: DATA_DIR/app_settings.json
APP_SETTINGS_PATH=

# APP_SETTINGS_TEMPLATE_PATH
# Optional custom path for the non-secret app settings template.
# Default: <repo-root>/config/app_settings.template.json
APP_SETTINGS_TEMPLATE_PATH=

# FLOWSHOPY_DB_URL
# Optional explicit Prisma database URL.
# Normally auto-derived from DATA_DIR as `file:<dataDir>/data.db`.
FLOWSHOPY_DB_URL=

# FLOWSHOPY_SKIP_API_LISTEN
# true disables API listen() in direct execution (mainly tests/tooling).
FLOWSHOPY_SKIP_API_LISTEN=false
